{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "verbatimModuleSyntax": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "prisma.config.ts"
  ]
}
