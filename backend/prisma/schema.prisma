datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ================= ENUM TYPES =================

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Quy tắc so sánh output của từng problem.
enum CheckerType {
  TOKENS
  FLOAT
}

// Trạng thái tổng hợp của một lần nộp chính thức.
enum SubmissionStatus {
  PENDING
  IN_PROGRESS
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
  SYSTEM_ERROR
}

// Trạng thái riêng của từng testcase.
enum TestcaseStatus {
  PENDING
  AC
  WA
  TLE
  MLE
  RE
  CE
  SYSTEM_ERROR
}

// ================= MODELS =================

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  email                String    @unique
  pwd                  String
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  role                 Role      @default(STUDENT)
  createdAt            DateTime  @default(now())
  termsAcceptedAt      DateTime?
  termsVersion         String?
  deletedAt            DateTime?
  tokenVersion         Int       @default(0)
  sessions             AuthSession[]

  submissions    Submission[]
  playgroundRuns PlaygroundRun[]

  roadmapProgress RoadmapProgress[]

  @@map("users")
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  deletedAt DateTime?

  problems ProblemCategory[]

  @@map("categories")
}

model Problem {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  slug        String      @unique
  description String      @db.Text
  difficulty  Difficulty  @default(MEDIUM)
  timeLimit   Int         @default(1000)
  memoryLimit Int         @default(256)
  isActive    Boolean     @default(true)
  checkerType CheckerType @default(TOKENS)
  deletedAt DateTime?
  testcaseVersion Int @default(1)

  categories      ProblemCategory[]
  testcases       Testcase[]
  submissions     Submission[]
  playgroundRuns  PlaygroundRun[]
  roadmapProblems RoadmapProblem[]

  roadmapProgress RoadmapProgress[]

  @@map("problems")
}

// Bảng liên kết Problem và Category.
model ProblemCategory {
  problemId  String @db.Uuid
  categoryId String @db.Uuid

  problem  Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([problemId, categoryId])
  @@map("problem_categories")
}

model Testcase {
  id             String  @id @default(uuid()) @db.Uuid
  problemId      String  @db.Uuid
  inputData      String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean @default(true)
  orderIndex     Int     @default(0)
  version        Int     @default(1)
  deletedAt      DateTime?

  problem Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results SubmissionResult[]

  @@map("testcases")
}

// Lưu lịch sử nộp bài chính thức.
model Submission {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  problemId      String           @db.Uuid
  language       String
  sourceCode     String           @db.Text
  status         SubmissionStatus @default(PENDING)
  totalTestcases Int              @default(0)
  totalTime      Int?
  maxMemory      Int?
  compileLog     String?          @db.Text
  createdAt      DateTime         @default(now())
  deadlineAt     DateTime?
  testcaseVersion Int @default(1)
  outboxJobs OutboxJob[]

  @@index([status, deadlineAt])
  @@index([userId, status, problemId])
  @@index([createdAt])

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  results SubmissionResult[]
  aiLogs  AILog[]

  completedRoadmaps RoadmapProgress[]

  @@map("submissions")
}

// Lượt chạy Playground được lưu bền để người học xem lại lịch sử.
// PROBLEM_TRIAL vẫn chỉ lưu trạng thái/kết quả tạm trong Redis.
model PlaygroundRun {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  problemId     String?   @db.Uuid
  problemTitle  String?
  language      String
  sourceCode    String    @db.Text
  customInput   String    @db.Text
  status        String    @default("PENDING")
  output        String?   @db.Text
  error         String?   @db.Text
  executionTime Int?
  memoryUsed    Int?
  cpuTime       Int?
  compileTime   Int?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  deadlineAt    DateTime

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  problem Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, deadlineAt])
  @@map("playground_runs")
}

// Tạo các hàng PENDING trước khi gửi job vào SQS.
// Result worker cập nhật từng hàng khi nhận kết quả.
model SubmissionResult {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  testcaseId   String @db.Uuid

  status TestcaseStatus @default(PENDING)

  executionTime Int @default(0)
  memoryUsed    Int?
  cpuTime       Int?
  compileTime   Int?

  output         String? @db.Text
  expectedOutput String? @db.Text

  errorLog String? @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  testcase   Testcase   @relation(fields: [testcaseId], references: [id], onDelete: Restrict)

  @@map("submission_results")
}

model AILog {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  errorContext String @db.Text
  aiResponse   String @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@map("ai_logs")
}

model Roadmap {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  problems RoadmapProblem[]

  progress RoadmapProgress[]

  @@map("roadmaps")
}

model RoadmapProblem {
  id         String @id @default(uuid()) @db.Uuid
  roadmapId  String @db.Uuid
  problemId  String @db.Uuid
  orderIndex Int    @default(0)

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, problemId])
  @@map("roadmap_problems")
}

model RoadmapProgress {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  roadmapId String @db.Uuid
  problemId String @db.Uuid

  // Trạng thái hoàn thành
  isSolved Boolean @default(false)

  // Thời gian AC
  solvedAt DateTime?

  // Số lần submit
  attemptCount Int @default(0)

  // Submission AC cuối cùng
  lastSubmissionId String? @db.Uuid

  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roadmap        Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Restrict)
  problem        Problem     @relation(fields: [problemId], references: [id], onDelete: Restrict)
  lastSubmission Submission? @relation(fields: [lastSubmissionId], references: [id], onDelete: SetNull)

  @@unique([userId, roadmapId, problemId])
  @@index([userId, roadmapId])
  @@index([roadmapId, problemId])
  @@map("roadmap_progress")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model OutboxJob {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  payload Json
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String? @db.Uuid
  sentAt DateTime?
  cancelledAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([sentAt, cancelledAt, availableAt])
  @@index([submissionId])
  @@map("outbox_jobs")
}
