# Copy to .env and replace placeholders; never commit real secrets.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/judge_db
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PORT=5001
REDIS_URL=redis://localhost:6379
RUN_TTL_SECONDS=3600

# Keep true for the existing combined API + result consumer workflow.
# Set false when running worker:dev/worker:start as a separate process.
RESULT_WORKER_ENABLED=true
AWS_REGION=ap-southeast-1
SQS_QUEUE_URL=
RESULT_QUEUE_URL=
SQS_ENDPOINT_URL=
# Leave empty to use the AWS SDK default credential chain/IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional: Google sign-in. Match this with frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Required only to send password-reset OTP emails.
SMTP_USER=
SMTP_PASS=

# Security, judging reliability and AI provider
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
SESSION_TTL_SECONDS=604800
TERMS_VERSION=v1
SUBMISSION_TIMEOUT_SECONDS=1800
MAINTENANCE_INTERVAL_SECONDS=5
WORKER_OFFLINE_SECONDS=45
SQS_AUTO_CREATE=false
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
