# Run node docker/setup-env.mjs to create .env without exposing secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=judge_db
POSTGRES_PORT=5433
# Keep this name to reuse the project's existing PostgreSQL volume.
POSTGRES_VOLUME_NAME=judge-system-monorepo_postgres_data
JWT_SECRET=CHANGE_ME
FRONTEND_PORT=8080
BACKEND_PORT=5001
RUN_TTL_SECONDS=3600

# AWS SQS. Use real URLs/credentials, or leave credentials blank for an IAM role.
# Import an existing backend/.env with: node docker/configure-aws.mjs --from-backend
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SQS_ENDPOINT_URL=
SQS_QUEUE_URL=
RESULT_QUEUE_URL=

# Optional: set the same OAuth client ID here for backend and VITE_GOOGLE_CLIENT_ID frontend build.
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Required only if password-reset OTP email delivery is needed.
SMTP_USER=
SMTP_PASS=

# Security, judging reliability and AI provider
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
SESSION_TTL_SECONDS=604800
TERMS_VERSION=v1
SUBMISSION_TIMEOUT_SECONDS=1800
MAINTENANCE_INTERVAL_SECONDS=5
WORKER_OFFLINE_SECONDS=45
# Queue creation is performed explicitly by docker/deploy.sh, not normal startup.
SQS_AUTO_CREATE=false
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
